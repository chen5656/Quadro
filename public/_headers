# Content Security Policy: everything the app needs comes from its own origin
# (NFR-009). Sign-in is a top-level redirect to the provider and back — no
# third-party script, iframe or XHR — and avatars are served by the Worker from
# R2, so `img-src 'self'` covers them.
#
# The one exception is Cloudflare Web Analytics, which the zone injects into
# every HTML response: the beacon is fetched from `static.cloudflareinsights.com`
# and reports to `cloudflareinsights.com`. Both have to be named here or the
# script is blocked and the analytics simply record nothing. Narrow on purpose —
# these two hosts, script and connect only.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com https://*.apple.com https://*.apple-mapkit.com https://media.licdn.com; connect-src 'self' https://cloudflareinsights.com; media-src 'self'; worker-src 'self' blob:; frame-src 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Generated once and never edited in place; a new sound design ships as a new
# file, so this can be cached for as long as the browser will keep it.
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker decides when every other cached file is allowed to change,
# so it must never be served from a cache itself. The default (4 hours) let a
# deployed update sit invisible for hours: the browser kept revalidating against
# a stale sw.js, so no new worker installed and the update banner never had a
# waiting worker to announce.
/sw.js
  Cache-Control: no-cache

# Content-hashed by the build — the filename changes whenever the bytes do, so
# there is nothing to revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Badges and story art are fixed artwork: a new one ships under a new name.
# Without this they fall to the platform default and a returning player
# revalidates every image on every visit.
/badges/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable
